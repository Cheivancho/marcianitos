{
  "expo": {
    "name": "Marcianitos",
    "slug": "marcianitos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marcianitos",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.marcianitos.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8588A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF4EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      ["expo-image-picker", {"cameraPermission": "Marcianitos usa la cámara para sacar la foto del ticket de compra.", "photosPermission": "Marcianitos usa tus fotos para guardar el ticket de compra."}],
      ["expo-notifications", {"color": "#E8588A"}],
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
